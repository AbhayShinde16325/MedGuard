The test file is completely empty. No test coverage whatsoever.

#### ✅ How to Make Dynamic

```python
import pytest
from backend.app.chatbot.router import QueryRouter, QueryType
from backend.app.chatbot.response_builder import ResponseBuilder

class TestQueryRouter:
    def test_price_query_routes_to_live_market(self):
        router = QueryRouter()
        assert router.route("What is Apple's share price?") == QueryType.LIVE_MARKET
    
    def test_report_query_routes_to_document(self):
        router = QueryRouter()
        assert router.route("Summarize the earnings report") == QueryType.DOCUMENT
    
    def test_general_query_routes_correctly(self):
        router = QueryRouter()
        assert router.route("What is a stock?") == QueryType.GENERAL

class TestResponseBuilder:
    def test_build_response_returns_string(self, mock_llm):
        builder = ResponseBuilder(mock_llm)
        result = builder.build_response("Tell me about Apple")
        assert isinstance(result, str)
        assert len(result) > 0
```

